# Copy to config.env, edit, then source it before launching Python.
# Never put database passwords, the wallet password or API tokens here.
export ORACLE_DSN='youradb_high'
export ORACLE_EXPECTED_PDB='CHANGE_ME_PDB'
export ORACLE_CONFIG_DIR='/absolute/path/to/Wallet_youradb'
export ORACLE_WALLET_LOCATION='/absolute/path/to/Wallet_youradb'
# OCI region, compartment and model are configured in sql/15_select_ai_config.sql.
# The app calls DDS_AGENT_RUNTIME.DDS_CURSOR_TEAM through the cursor bridge.
# The cloned DDS_NATIVE_OCI_PROFILE selects xai.grok-4.3; no local model or OCI API key.

# ORACLE_DSN is an alias from tnsnames.ora in ORACLE_CONFIG_DIR.
# The mTLS Thin-mode path requires ewallet.pem in ORACLE_WALLET_LOCATION.
# A full TCPS descriptor from OCI Database Connection can also be used as DSN.
# Keep ssl_server_dn_match=yes. The app prompts for the wallet password.
# For a separately configured wallet-free TLS connection, unset both wallet
# settings and follow the Autonomous TLS documentation; mTLS is this lab's path.

# Optional delegated CLI mode only, after completing Lab 7.
# export ENTRA_TENANT_ID='tenant-guid'
# export ENTRA_CLIENT_ID='agent-application-client-guid'
# export ENTRA_DB_SCOPE='https://tenant.onmicrosoft.com/resource-guid/.default'

# Native Oracle RUN_TEAM through DDS-authorized cursors (scripts 22-24).
# shared_team retains the original direct shared-team path for diagnostics.
export SELECT_AI_EXECUTION=cursor_bridge
